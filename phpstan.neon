includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - src
        - database/migrations
    treatPhpDocTypesAsCertain: false
    # phpstan-baseline.neon фиксирует pre-existing legacy errors (bump phpstan 1.x → 2.x).
    # Новые ошибки в src/* всё ещё будут падать. Старые ошибки чистятся по мере касания файла.
