{
    "name": "mercurioplatform/tables",
    "description": "Reusable list/table engine for Laravel admin (Bootstrap 5 + jQuery + Blade).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "tables",
        "datatable",
        "admin",
        "bootstrap",
        "blade",
        "saved-views",
        "bulk-actions"
    ],
    "homepage": "https://github.com/mercurioplatform/tables",
    "support": {
        "issues": "https://github.com/mercurioplatform/tables/issues",
        "source": "https://github.com/mercurioplatform/tables"
    },
    "authors": [
        {
            "name": "Timur Turdyev"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "openspout/openspout": "^4.26",
        "orchestra/testbench": "^11.0"
    },
    "suggest": {
        "openspout/openspout": "Required for XLSX export (^4.26). Install in the host project to enable `?format=xlsx`."
    },
    "autoload": {
        "psr-4": {
            "Mercurio\\Tables\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mercurio\\Tables\\TablesServiceProvider"
            ]
        }
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.gitattributes",
            "/.gitignore",
            "/.pint.json",
            "/art",
            "/docs",
            "/examples",
            "/tests",
            "/composer.lock",
            "/eslint.config.js",
            "/node_modules",
            "/package.json",
            "/package-lock.json",
            "/phpstan-baseline.neon",
            "/phpstan.neon"
        ]
    },
    "scripts": {
        "pint": "pint --test",
        "pint:fix": "pint",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "ci": [
            "@pint",
            "@phpstan"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
