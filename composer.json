{
    "name": "mercurioplatform/tables",
    "description": "Reusable list/table engine for Laravel admin (Bootstrap 5 + jQuery + Blade).",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Timur Turdyev"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Mercurio\\Tables\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mercurio\\Tables\\TablesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
